{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "maitri",
  "version": "1.0.0",
  "title": "maitri",
  "description": "maitri desktop menu, keybindings and pickers for Vicinae",
  "categories": [
    "Applications",
    "Productivity"
  ],
  "license": "MIT",
  "author": "maitrios",
  "icon": "icon.png",
  "commands": [
    {
      "name": "maitri-menu",
      "title": "maitri Menu",
      "subtitle": "maitri",
      "description": "The maitri control menu (trigger, style, setup, install, update, system…)",
      "mode": "view"
    },
    {
      "name": "keybindings",
      "title": "maitri Keybindings",
      "subtitle": "maitri",
      "description": "Searchable Hyprland keybindings",
      "mode": "view"
    },
    {
      "name": "theme-picker",
      "title": "maitri Theme",
      "subtitle": "maitri",
      "description": "Pick the maitri theme",
      "mode": "view"
    },
    {
      "name": "background-picker",
      "title": "maitri Background",
      "subtitle": "maitri",
      "description": "Pick the desktop background",
      "mode": "view"
    },
    {
      "name": "unlock-picker",
      "title": "maitri Unlock Screen",
      "subtitle": "maitri",
      "description": "Pick the boot and unlock screen",
      "mode": "view"
    },
    {
      "name": "menu-input",
      "title": "maitri Input",
      "subtitle": "maitri",
      "description": "Text prompt used by maitri-menu-input",
      "mode": "view"
    }
  ],
  "preferences": [],
  "scripts": {
    "build": "vici build",
    "dev": "vici develop",
    "lint": "vici lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@vicinae/api": "^0.29.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "typescript": "^7.0.2",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=20"
  }
}
